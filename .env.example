# Etapa 1 — Ideação (OpenAI GPT-4o)
OPENAI_API_KEY=

# Etapa 2 — Narração (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Etapa 4 — Visual (Gemini 2.5 Flash Image)
GEMINI_API_KEY=

# Etapa 5 — Publicação (YouTube Data API, OAuth client para upload)
# Baixe o client_secret.json no Google Cloud Console (Credenciais > Criar credenciais > ID do cliente OAuth > Aplicativo para computador)
# e salve o caminho dele aqui.
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=auth/client_secret.json
YOUTUBE_OAUTH_TOKEN_FILE=auth/token.json
